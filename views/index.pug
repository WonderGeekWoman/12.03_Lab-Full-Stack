extends layout

block content
  h1= title
  h2 Keep track of the tasks you need to complete!

  hr
  p Add a new task
  form(method='POST' action='/create')
    input(type='text', name='task', id='task', onchange="this.value = this.value.trim()", required)
    button(type='submit') Create Task

  h2 Tasks
  ol
  each val in todos
    if val.completed == 0
      li
        .task-info
          span= val.task
        .task-actions
          form(method='POST' action='/update')
            label Edit:
            input(type='hidden', name='id', value=val.id)
            input(type='text', name='task', value=val.task, required)
            button(type='submit') Update Task
          form(method='POST' action='/complete')
            input(type='hidden', name='id', value=val.id)
            button(type='submit') Completed
          form(method='POST' action='/delete')
            input(type='hidden', name='id', value=val.id)
            button(type='submit') Delete

  h2 Completed
  ol
  each val in todos
    if val.completed > 0
      li
        .task-info
          span= val.task
        .task-actions
          form(method='POST' action='/undo')
            input(type='hidden', name='id', value=val.id)
            button(type='submit') Undo
          form(method='POST' action='/delete')
            input(type='hidden', name='id', value=val.id)
            button(type='submit') Delete
